# Genealogy Extractor Environment Configuration
# Copy this file to .env and modify as needed

# Django Settings
DJANGO_SECRET_KEY=django-insecure-demo-key-change-in-production
DEBUG=True

# Database Configuration
DB_HOST=db
DB_NAME=genealogy_extractor
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Redis Configuration (for Celery)
REDIS_HOST=redis
REDIS_PORT=6379

# Default Admin User (created automatically in Docker)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@localhost

# Media Storage
MEDIA_ROOT=/app/media

# Ollama Configuration
OLLAMA_HOST=the-area.local
OLLAMA_PORT=11434
OLLAMA_LLM_MODEL=aya:35b-23
OLLAMA_EMBEDDING_MODEL=zylonai/multilingual-e5-large:latest
